# ============================================
# MyLibrary RAG - 环境变量配置
# ============================================
#
# 使用说明：
# 1. 复制此文件为 .env: copy .env.example .env
# 2. 填入下方各配置项的实际值
# 3. 不要将包含真实密钥的 .env 文件提交到版本控制
#
# 详细配置指南请参阅：docs/API_CONFIG_GUIDE.md
#

# ============================================
# 必填配置
# ============================================

# DeepSeek API 密钥
# 获取地址：https://platform.deepseek.com/api_keys
# 格式示例：sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=your_api_key_here

# API 基础 URL（OpenAI 兼容接口）
# 常用选项：
#   - DeepSeek: https://api.deepseek.com/v1
#   - OpenAI:   https://api.openai.com/v1
#   - 通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1
#   - 智谱AI:   https://open.bigmodel.cn/api/paas/v4
OPENAI_BASE_URL=https://api.deepseek.com/v1

# ============================================
# 可选配置
# ============================================

# 模型名称（默认 deepseek-chat）
# 可选值：
#   - deepseek-chat       (通用对话，性价比高)
#   - deepseek-reasoner   (推理增强，适合复杂问题)
#   - gpt-4o / gpt-3.5-turbo (使用 OpenAI 时)
MODEL_NAME=deepseek-chat

# 组织 ID（仅 OpenAI 需要，其他提供商留空）
# OPENAI_ORG_ID=

# HTTP 代理（如需代理访问 API）
# OPENAI_PROXY=http://127.0.0.1:7890

# ============================================
# 高级配置（一般无需修改）
# ============================================

# LLM 温度参数（0=确定性输出，1=随机性高）
# LLM_TEMPERATURE=0

# LLM 最大 token 数
# LLM_MAX_TOKENS=2048

# 请求超时时间（秒）
# LLM_TIMEOUT=60
